# AI Snipping Tool Stage 1 prototype; generated by utils.user_service.
# Manual-only: deliberately no [Install] / WantedBy / autostart entry.
[Unit]
Description=AI Snipping Tool (graphical user session prototype)
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=@ROOT@
Environment=XDG_RUNTIME_DIR=%t
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=QT_QPA_PLATFORM=wayland
ExecCondition=@PYTHON@ -u -m utils.user_service --check-session
ExecStart=@PYTHON@ -u @MAIN@
Slice=app.slice
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=30
LimitCORE=0
